# Required to run the pipeline (pnpm pipeline) and generate datasets (pnpm data:generate).
# The hosted demo replays pre-computed runs and does not need a key.
# DISTILL_API_KEY is preferred; ANTHROPIC_API_KEY also works.
DISTILL_API_KEY=

# Optional overrides. Defaults are in src/pipeline/models.ts.
# DISTILL_EXTRACT_MODEL=claude-haiku-4-5
# DISTILL_SYNTH_MODEL=claude-opus-5
